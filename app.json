{
  "expo": {
    "name": "BancaKids",
    "slug": "bancakids",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bancakids",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bancakids.app"
    },
    "android": {
      "package": "com.bancakids.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"]
  }
}
